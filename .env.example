# Copy to .env.local (local), or set in Vercel per environment (Preview = staging,
# Production = production). Each environment uses its own Supabase project and keys.
# Never commit real values.

# Supabase project URL for this environment, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable (or legacy anon) key. RLS protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Used only by the GHL integration (src/lib/supabase/admin.ts);
# never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallbacks accepted while Supabase transitions key names
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public site origin for canonical URLs and the sitemap, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional: Slack/Discord incoming-webhook URL; every server error posts a short alert.
ERROR_ALERT_WEBHOOK_URL=

# GoHighLevel integration (docs/ghl-integration.md). Server-side only; never NEXT_PUBLIC_.
# Shared secret for the GHL webhooks (/api/integrations/ghl and /api/integrations/ghl/events).
GHL_WEBHOOK_SECRET=
# Private Integration token + sub-account id: the sync reads (and, with write-back on, updates) GHL.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Bearer secret for the scheduled sync (/api/integrations/ghl/sync): Vercel Cron + GitHub Actions.
CRON_SECRET=
# Optional extra photo hosts, comma-separated.
# GHL_FILE_HOSTS=
# Only for scripts/import-ghl.mjs (local use):
# GHL_FORM_ID=            # one or more form ids, comma-separated
# GHL_SURVEY_ID=          # optional survey ids, comma-separated
# IMPORT_TARGET_URL=

# Roles that must use two-step sign-in (default owner,administrator). "none" disables
# the requirement: emergency use only (docs/operations.md).
# MFA_REQUIRED_ROLES=owner,administrator

# Demo mode (docs/demo-mode.md) needs none of the above: `npm run demo` ignores this
# file's real-service values and runs on an in-memory sandbox. Never set
# NEXT_PUBLIC_DEMO_MODE on the production deployment.
